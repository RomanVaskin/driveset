# Public Yandex Metrika counter id, embedded at build time (see OLNOO_ARCHITECTURE.md,
# "Атрибуция и события"). Safe to expose — it's a public counter id, not a secret.
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# OLNOO CRM lead intake (POST /api/lead -> POST <OLNOO_CRM_URL>/api/leads/inbound in olnoo-admin).
# Server-only — never exposed to the browser, never in NEXT_PUBLIC_*, never committed with a real
# value. OLNOO_CRM_URL must be the CRM's origin only (https, no userinfo/query/hash); /api/lead
# appends /api/leads/inbound itself. OLNOO_CRM_API_KEY must match OLNOO_CRM_API_KEY in olnoo-admin's
# own env — it's the shared secret that endpoint authenticates with (sent as "Authorization: Bearer
# <key>"). Missing either one makes /api/lead fail closed (503) rather than silently dropping leads.
OLNOO_CRM_URL=https://admin.olnoo.com
OLNOO_CRM_API_KEY=
